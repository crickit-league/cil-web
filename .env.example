# Copy this file to .env (or .env.local) and fill in real values.
# Never commit real secrets — .env* (except .env.example) is gitignored.
# See docs/service-setup.md for how to obtain each of these.

# Neon Postgres — pooled connection, used by the app at runtime (src/lib/db/prisma.ts)
# Use the "preview/main" branch's connection string here, NEVER "production" —
# see docs/service-setup.md §3 for why local dev must stay off the real database.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon Postgres — direct/unpooled connection, used by Prisma Migrate (prisma.config.ts)
# Same branch as DATABASE_URL above — "preview/main", not "production".
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js — session/token signing secret. Generate with `npx auth secret`.
AUTH_SECRET=""

# Resend — transactional email (magic-link sign-in, registration confirmation,
# later approval invites). Leave empty in dev: magic links log to the console
# instead of sending (see src/lib/auth/send-magic-link.ts).
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""

# --- Not wired into the code yet (see docs/STATUS.md) — set these up ahead of
# --- time via docs/service-setup.md so they're ready when each TODO lands.

# Cloudflare Turnstile — bot protection on the registration form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Sentry — error tracking
SENTRY_DSN=""
