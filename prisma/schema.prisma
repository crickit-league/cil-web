// Crick-It Inter League — data model
//
// Scope note: this schema currently covers only what Phase 1a needs
// (season windows + team registration). The full target domain model —
// teams, rosters, fixtures, scorecards, stats, standings — is documented
// in docs/architecture.md §6 and grows incrementally as each phase's
// features are actually built, not speculatively ahead of them.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts / env, not here — see
// https://pris.ly/d/prisma7-client-config
datasource db {
  provider = "postgresql"
}

enum SeasonStatus {
  UPCOMING
  REGISTRATION_OPEN
  ACTIVE
  ARCHIVED
}

enum RegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FeeStatus {
  UNPAID
  PAID
  WAIVED
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// Not scoped beyond "global" yet — no season- or team-scoped roles
// (captain, player) exist until Phase 1b. See docs/architecture.md §6/§7
// for why this is a separate table rather than an enum on User.
enum RoleScopeType {
  GLOBAL
}

// Auth.js (magic link / email) — see docs/architecture.md §7.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  roles    UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserRole {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  scopeType RoleScopeType @default(GLOBAL)
  scopeId   String?

  createdAt DateTime @default(now())

  @@unique([userId, role, scopeType, scopeId])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum FeeTier {
  STANDARD // $650
  SPONSORSHIP // $800 "with Sponsorship"
}

model Season {
  id                    String       @id @default(cuid())
  name                  String // e.g. "2026-27"
  status                SeasonStatus @default(UPCOMING)
  registrationOpensAt   DateTime
  registrationClosesAt  DateTime

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seasons")
}

// A Phase 1a team-registration submission. Not yet linked to a Team,
// Person, or User — that linkage happens in Phase 1b, once a registration
// is approved and the captain accepts their setup invite.
model Registration {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])

  teamName          String
  captainName       String
  captainEmail      String
  captainMobile     String
  viceCaptainName   String?
  viceCaptainEmail  String?
  viceCaptainMobile String?
  feeTier           FeeTier @default(STANDARD)
  marketingConsent  Boolean @default(false)

  status    RegistrationStatus @default(SUBMITTED)
  feeStatus FeeStatus          @default(UNPAID)

  notes String?

  // Free-text for now — becomes a proper admin-user relation once
  // Phase 1a auth exists.
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId, status])
  @@map("registrations")
}
